{
  "name": "msm-portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=apps/frontend-react",
    "dev:backend": "npm run start:dev --workspace=apps/backend-nestjs",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:shared": "npm run build --workspace=shared-types",
    "build:frontend": "npm run build --workspace=apps/frontend-react",
    "build:backend": "npm run build --workspace=apps/backend-nestjs",
    "build": "npm run build:shared && npm run build:frontend && npm run build:backend",
    "lint:frontend": "npm run lint --workspace=apps/frontend-react",
    "test:frontend": "npm run test --workspace=apps/frontend-react",
    "test:backend": "npm run test:e2e --workspace=apps/backend-nestjs",
    "test": "npm run test:frontend && npm run test:backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "shared-types": "^1.0.0"
  }
}
