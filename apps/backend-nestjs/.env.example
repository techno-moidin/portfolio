# =========================================================================
# MSM Portfolio - NestJS Backend Environment Template
# =========================================================================
# Copy this file to '.env' locally for custom environment configurations.
# DO NOT commit the resulting files carrying active credentials to Git.
# =========================================================================

# The active port for your NestJS application (defaults to 3000 if not specified)
PORT=3000

# Comma-separated list of dynamic domains authorized by the CORS policy.
# Localhost and Vercel domains (*.vercel.app) are authorized automatically.
# Example: ALLOWED_ORIGINS=https://custom-domain.com,https://staging.custom-domain.com
ALLOWED_ORIGINS=

# MongoDB Atlas connection string for traffic tracking
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio

# Secure passcode to unlock administrative visitor traffic analytics dashboard
ADMIN_PASSCODE=

# Secret URL phrase value (e.g. ?gateway=msm-gateway) to reveal the analytics tab
ADMIN_GATEWAY_KEY=
